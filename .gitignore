# Only distributable source is allowed. Keep user/runtime data outside this repo.
*
!/.gitignore
!/.gitattributes
!/LICENSE
!/VERSION
!/README.md
!/README.zh-CN.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/SECURITY.md
!/.github/
!/.github/workflows/
!/.github/workflows/ci.yml
!/.github/pull_request_template.md
!/tools/
!/tools/*.py
!/skills/
!/skills/x-article-layout/
!/skills/x-article-layout/SKILL.md
!/skills/x-article-layout/SKILL.zh-CN.md
!/skills/x-article-layout/requirements.txt
!/skills/x-article-layout/agents/
!/skills/x-article-layout/agents/*.yaml
!/skills/x-article-layout/references/
!/skills/x-article-layout/references/en/
!/skills/x-article-layout/references/en/*.md
!/skills/x-article-layout/references/zh-CN/
!/skills/x-article-layout/references/zh-CN/*.md
!/skills/x-article-layout/scripts/
!/skills/x-article-layout/scripts/*.py
!/skills/x-article-layout/scripts/*.mjs
**/__pycache__/
**/.pytest_cache/
**/*.pyc
**/*.pyo
**/.env
**/.env.*
**/*credentials*
**/*secrets*
